{
  "manifest_version": 3,
  "name": "Email to vCard",
  "version": "1.0.0",
  "description": "Create vCard contacts from email sender info and signatures in Gmail and Outlook Web",
  "permissions": [],
  "icons": {
    "16": "icons/button-icon.png",
    "48": "icons/button-icon.png",
    "128": "icons/button-icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["src/signature-parser.js", "src/vcard-generator.js", "src/content-gmail.js", "src/content-outlook.js", "src/main.js"],
      "css": ["src/styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/button-icon.png"],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ]
    }
  ]
}
